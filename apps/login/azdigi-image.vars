# Build-time variables for the AZDIGI login image (NEXT_PUBLIC_* are inlined by the Next production build).
# One source for local builds (scripts/azdigi/make-image.sh) and the release workflow. No secrets belong here.
# Changing a theme value means a new image tag.
NEXT_PUBLIC_BASE_PATH=/ui/v2/login
NEXT_PUBLIC_APPLICATION_NAME=AZDIGI
NEXT_PUBLIC_THEME_ROUNDNESS=mid
NEXT_PUBLIC_THEME_LAYOUT=top-to-bottom
NEXT_PUBLIC_THEME_APPEARANCE=flat
NEXT_PUBLIC_THEME_SPACING=regular
